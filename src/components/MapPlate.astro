---
import CompassRose from './CompassRose.astro';

// The map as a printed plate: server-drawn SVG, readable with no JavaScript. Colour steps are
// classes (s0..s6, or s-none for "sem dado") so the browser script can recolour without redrawing.
interface PlateItem {
  codigo: string;
  nome: string;
  d: string;
  cx: number;
  cy: number;
  /** Position on the colour ramp, or null for "sem dado". */
  step: number | null;
  valueText: string;
  /** Short form of the value, printed under the tag as a sounding. */
  compact?: string | undefined;
  /** Present when the shape leads to its own page; the shape then becomes a keyboard-reachable link. */
  href?: string | undefined;
  /** Short lettering printed on the shape, e.g. a state abbreviation. */
  tag?: string;
}

interface Props {
  viewBox: string;
  label: string;
  items: PlateItem[];
  /** Code of the state capital, marked as a seat (ring and dot) and lettered with its name. */
  capital?: string | undefined;
  /** A framed inset for islands far offshore; their shapes are among `items`, already drawn inside `frame`. */
  inset?: { frame: { x: number; y: number; width: number; height: number }; title: string; note: string } | undefined;
}

const { viewBox, label, items, capital, inset } = Astro.props;
const linked = items.some((item) => item.href !== undefined);
const shapeClass = (step: number | null) => `shape ${step === null ? 's-none' : `s${String(step)}`}`;

// The name goes beside the seat, on the side with more room, so it never runs off the plate.
const seat = items.find((item) => item.codigo === capital);
const [minX = 0, minY = 0, width = 0, height = 0] = viewBox.split(/\s+/).map(Number);
const nameOnLeft = seat !== undefined && seat.cx > minX + width * 0.62;
const insetTopRight = inset !== undefined && inset.frame.y < minY + height / 2 && inset.frame.x > minX + width / 2;
---

<figure class:list={['plate', { 'plate--inset-top-right': insetTopRight }]} data-plate>
  <svg viewBox={viewBox} role={linked ? 'group' : 'img'} aria-label={label}>
    <defs>
      <pattern id="sem-dado" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" style="fill: var(--color-land)"></rect>
        <line x1="0" y1="0" x2="0" y2="6" style="stroke: var(--scale-no-data-hatch); stroke-width: 1.2"></line>
      </pattern>
    </defs>
    {
      inset !== undefined && (
        <rect class="inset-frame" x={inset.frame.x} y={inset.frame.y} width={inset.frame.width} height={inset.frame.height} aria-hidden="true"></rect>
      )
    }
    <g data-shapes>
      {
        items.map((item) =>
          item.href !== undefined ? (
            <a href={item.href} aria-label={`${item.nome}: ${item.valueText}`}>
              <path class={shapeClass(item.step)} d={item.d} data-codigo={item.codigo}></path>
            </a>
          ) : (
            <path class={shapeClass(item.step)} d={item.d} data-codigo={item.codigo}></path>
          ),
        )
      }
    </g>
    <!-- Outline of the active shape, drawn on top without moving any node (moving a focused link would blur it). -->
    <path class="shape-highlight" data-highlight d="" aria-hidden="true"></path>
    {
      inset !== undefined && (
        <g class="inset-caption" aria-hidden="true">
          <text class="inset-title" x={inset.frame.x + 10} y={inset.frame.y + 16}>{inset.title}</text>
          <text class="inset-note" x={inset.frame.x + 10} y={inset.frame.y + 32}>{inset.note}</text>
        </g>
      )
    }
    {
      seat !== undefined && (
        <g class="capital-mark" aria-hidden="true" data-capital={seat.codigo}>
          <circle class="capital-halo" cx={seat.cx} cy={seat.cy} r="9"></circle>
          <circle class="capital-ring" cx={seat.cx} cy={seat.cy} r="6.5"></circle>
          <circle class="capital-dot" cx={seat.cx} cy={seat.cy} r="2.4"></circle>
          <text class:list={['capital-name', { 'capital-name--left': nameOnLeft }]} x={seat.cx + (nameOnLeft ? -14 : 14)} y={seat.cy}>
            {seat.nome}
          </text>
        </g>
      )
    }
    <g aria-hidden="true">
      {
        items
          .filter((item) => item.tag !== undefined)
          .map((item) => (
            <>
              <text class="shape-label" x={item.cx} y={item.cy - 4}>{item.tag}</text>
              {item.compact !== undefined && (
                <text class="shape-sounding" x={item.cx} y={item.cy + 9} data-sounding={item.codigo}>{item.compact}</text>
              )}
            </>
          ))
      }
    </g>
  </svg>
  <div class="rose-corner" aria-hidden="true"><CompassRose /></div>
  <div class="tip" data-tip hidden></div>
</figure>
